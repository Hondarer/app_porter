// porter のサービス定義。設定項目の説明は docs/config.md を参照してください。
{
  // すべてのサービスに共通する既定値。
  "global": {
    "window_size": 64,
    "max_payload": 1400,
    "udp_health_interval_ms": 3000,
    "udp_health_timeout_ms": 10000,
    "tcp_health_interval_ms": 10000,
    "tcp_health_timeout_ms": 31000,
    // フロー制御: 受信側の通知キューの容量 (バイト)。0 または省略で無効。
    // 指定すると、受信側の未処理の DATA が容量の 80% を超えたときに送信側の送出を止め、
    // 50% を下回ったときに再開する。容量の決め方は docs/config.md の「フロー制御の設定」を参照。
    // "flow_control_capacity": 4194304,
    // OS の受信バッファーに基づく送出上限: unicast、multicast、broadcast、unicast_bidir、unicast_bidir_n1 の受信側は、
    // 容量の指定がなくても、OS の受信バッファーに収まる数を超えて送らないよう送信側へ知らせる (既定で有効)。
    // 受信バッファーの幅の計算に使う割合 (%)。-1 で無効。説明は docs/config.md の「OS の受信バッファーに基づく送出上限」を参照。
    // "flow_control_receive_buffer_percent": 100,
    // UDP のソケットを開くときに OS へ要求する受信バッファーの大きさ (バイト)。-1 で要求しない。
    // "udp_receive_buffer_size": 4194304,
    // 1 対 N の送信側および N:1 サーバーで、遅い相手を除外または切断する数の上限 (台数と %、-1 で無効) と猶予時間 (ms)。
    // "flow_control_excluded_receiver_count": 1,
    // "flow_control_excluded_receiver_percent": 10,
    // "flow_control_grace_ms": 200,
    // multicast と broadcast の送信側が監視対象から受けるフロー制御パケットの予算 (DATA 100 パケットあたりの数) と、
    // 監視する数の下限 (台数)。説明は docs/config.md の「multicast と broadcast の監視対象」を参照。
    // "flow_control_feedback_percent": 5,
    // "flow_control_monitored_receiver_count": 1,
  },
  "services": {
    // 一方向ユニキャスト: ループバックで動作確認。
    "1001": {
      "type": "unicast",
      "src_addr1": "127.0.0.1",
      "dst_addr1": "127.0.0.1",
      "dst_port": 5001,
    },
    "1002": {
      "type": "unicast",
      "src_addr1": "192.168.1.10",
      "dst_addr1": "192.168.1.20",
      "dst_port": 5002
    },
    "1003": {
      "type": "unicast",
      "src_addr1": "sender.example.local",
      "dst_addr1": "receiver.example.local",
      "dst_port": 5003
    },
    "1004": {
      "type": "unicast",
      "src_addr1": "192.168.1.10",
      "src_port": 5010,
      "dst_addr1": "192.168.1.20",
      "dst_port": 5004
    },
    "1005": {
      "type": "unicast",
      "src_addr1": "192.168.1.10",
      "dst_addr1": "192.168.1.20",
      "dst_port": 5005,
      "pack_wait_ms": 5
    },
    // 暗号化: 64 桁の十六進鍵。
    "1006": {
      "type": "unicast",
      "src_addr1": "127.0.0.1",
      "dst_addr1": "127.0.0.1",
      "dst_port": 5006,
      "encrypt_key": "0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f0a1b2c3d4e5f6a7b8c9d0e1f2a3b"
    },
    // 暗号化: 任意のパスフレーズ。
    "1007": {
      "type": "unicast",
      "src_addr1": "127.0.0.1",
      "dst_addr1": "127.0.0.1",
      "dst_port": 5007,
      "encrypt_key": "MySecretPassphrase2026!"
    },
    // 双方向 UDP: 両端が同じサービス定義を使用。
    "1031": {
      "type": "unicast_bidir",
      "src_addr1": "127.0.0.1",
      "src_port": 5031,
      "dst_addr1": "127.0.0.1",
      "dst_port": 5032
    },
    "1041": {
      "type": "unicast_bidir",
      "src_addr1": "192.168.1.10",
      "src_port": 5041,
      "dst_addr1": "192.168.1.20",
      "dst_port": 5042
    },
    "1051": {
      "type": "unicast_bidir",
      "src_addr1": "192.168.1.10",
      "dst_addr1": "192.168.1.20",
      "dst_port": 5052
    },
    "1055": {
      "type": "unicast_bidir",
      "src_port": 5055,
      "dst_addr1": "192.168.1.20",
      "dst_port": 5056
    },
    // N:1 双方向 UDP: 複数クライアントを受け入れる。
    "1060": {
      "type": "unicast_bidir_n1",
      "dst_addr1": "127.0.0.1",
      "dst_port": 5060
    },
    "1061": {
      "type": "unicast_bidir_n1",
      "dst_addr1": "192.168.1.20",
      "dst_port": 5061
    },
    "1062": {
      "type": "unicast_bidir_n1",
      "dst_addr1": "192.168.1.20",
      "dst_port": 5062,
      "src_port": 6000
    },
    // マルチキャスト: グループ宛てに送信。
    "2001": {
      "type": "multicast",
      "src_addr1": "127.0.0.1",
      "dst_port": 6001,
      "multicast_group": "239.0.0.1",
      "ttl": 1
    },
    "2002": {
      "type": "multicast",
      "src_addr1": "192.168.1.10",
      "dst_port": 6002,
      "multicast_group": "239.0.0.2",
      "ttl": 1
    },
    // 別ホスト間のマルチキャスト: 送信側は src_addr1、受信側の参加 NIC は dst_addr1。
    "2003": {
      "type": "multicast",
      "src_addr1": "192.168.1.10",
      "dst_addr1": "192.168.1.20",
      "dst_port": 6003,
      "multicast_group": "239.0.0.3",
      "ttl": 1
    },
    // ブロードキャスト: 同一ネットワークへ送信。
    "3001": {
      "type": "broadcast",
      "src_addr1": "127.0.0.1",
      "dst_port": 7001,
      "broadcast_addr": "255.255.255.255"
    },
    "3002": {
      "type": "broadcast",
      "src_addr1": "192.168.1.10",
      "dst_port": 7002,
      "broadcast_addr": "192.168.1.255"
    },
    // 複数経路: 対応する送信元と宛先を番号で指定。
    "1010": {
      "type": "unicast",
      "src_addr1": "192.168.1.10",
      "dst_addr1": "192.168.1.20",
      "src_addr2": "10.0.0.10",
      "dst_addr2": "10.0.0.20",
      "dst_port": 5010
    },
    "2010": {
      "type": "multicast",
      "src_addr1": "192.168.1.10",
      "src_addr2": "10.0.0.10",
      "dst_port": 6010,
      "multicast_group": "239.0.0.10",
      "ttl": 1
    },
    "3010": {
      "type": "broadcast",
      "src_addr1": "192.168.1.10",
      "src_addr2": "10.0.0.10",
      "dst_port": 7010,
      "broadcast_addr": "255.255.255.255"
    },
    // RAW モード: 再送制御を使わない。
    "1021": {
      "type": "unicast_raw",
      "src_addr1": "127.0.0.1",
      "dst_addr1": "127.0.0.1",
      "dst_port": 5021
    },
    "2021": {
      "type": "multicast_raw",
      "src_addr1": "127.0.0.1",
      "dst_port": 6021,
      "multicast_group": "239.0.0.21",
      "ttl": 1
    },
    "3021": {
      "type": "broadcast_raw",
      "src_addr1": "192.168.1.10",
      "dst_port": 7021,
      "broadcast_addr": "255.255.255.255"
    }
  }
}
